{
  "name": "livevoz-teleprompter",
  "version": "14.0.0",
  "description": "LiveVoz V14 Stage Director con sincronización total, señales, preflight, partes por instrumento, bloqueo de escenario, telemetría y control en vivo",
  "author": {
    "name": "JOSUE ALEXIS CHAVEZ GUEVARA",
    "email": "josue.alexis.chavez.guevara@livevoz.app"
  },
  "homepage": "https://livevoz.app",
  "license": "UNLICENSED",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "stage-server": "node stage-server.cjs",
    "stage-health": "node scripts/check-stage-network.cjs",
    "check": "node scripts/check-project.cjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.livevoz.teleprompter",
    "productName": "LiveVoz Teleprompter",
    "copyright": "Copyright © 2026 JOSUE ALEXIS CHAVEZ GUEVARA",
    "asar": true,
    "files": [
      "teleprompter.html",
      "teleprompter-v11.html",
      "livevoz-v11-runtime.js",
      "livevoz-v13-stage.html",
      "livevoz-v13-preload.cjs",
      "livevoz-v13-bridge.js",
      "livevoz-v13-2-sync.js",
      "livevoz-v14-runtime.js",
      "livevoz-mobile-v13-1.html",
      "livevoz-mobile-v13-2.html",
      "livevoz-logo.png",
      "manifest.webmanifest",
      "sw.js",
      "stage-server.cjs",
      "electron-main.cjs",
      "scripts/**/*",
      "package.json"
    ],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"], "icon": "livevoz-logo.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LiveVoz Teleprompter"
    },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.music" },
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo" }
  }
}